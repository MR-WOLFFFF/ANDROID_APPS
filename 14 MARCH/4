import subprocess

CAN_IFACE = "can1"

# Internal states
asr_state = False
esp_state = False
hadc_state = False


def run_cansend(frame):
    command = ["cansend", CAN_IFACE, frame]
    print("Running:", " ".join(command))

    result = subprocess.run(
        command,
        text=True,
        capture_output=True
    )

    if result.returncode != 0:
        error = result.stderr.strip()
        print("ERROR:", error)
        return False, error

    return True, f"Sent {frame}"


def build_emission_bmf1_frame():
    """
    ID 001, DLC 3

    HADC ON  = 001#010000
    ESP ON   = 001#000100
    ASR ON   = 001#000200

    Combined logic:
    HADC + ESP + ASR = 001#010300
    """

    byte0 = 0x01 if hadc_state else 0x00

    byte1 = 0x00
    if esp_state:
        byte1 |= 0x01
    if asr_state:
        byte1 |= 0x02

    byte2 = 0x00

    return f"001#{byte0:02X}{byte1:02X}{byte2:02X}"


def send_current_state():
    frame = build_emission_bmf1_frame()
    success, message = run_cansend(frame)
    return success, message


def toggle_asr():
    global asr_state

    asr_state = not asr_state
    success, message = send_current_state()

    if not success:
        asr_state = not asr_state

    return asr_state, success, message


def toggle_esp():
    global esp_state

    esp_state = not esp_state
    success, message = send_current_state()

    if not success:
        esp_state = not esp_state

    return esp_state, success, message


def toggle_hadc():
    global hadc_state

    hadc_state = not hadc_state

    success, message = send_current_state()

    if success:
        if hadc_state:
            success2, message2 = run_cansend("100#20")
        else:
            success2, message2 = run_cansend("100#00")

        if not success2:
            hadc_state = not hadc_state
            return hadc_state, False, message2

    else:
        hadc_state = not hadc_state
        return hadc_state, False, message

    return hadc_state, True, message
